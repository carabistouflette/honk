namespace deps;
import std;
import os;
import toml;
import .manifest;
import .platform;
import .source;
import .project;
import .toolchain;
struct Node { name: u8[], path: u8[], git: u8[], rev: u8[], commit: u8[], directory: u8[], entry: u8[], production: bool = false, enabled: bool = true, visiting: bool = true }
struct Edge { parent: i64, child: i64 }
root struct Graph { edges: Edge[>..], current: i64 = -1, nodes: Node[>..], old: Node[>..], cache: u8[>..], revision: u8[>..], locked: bool = false, offline: bool = false, update: bool = false }
fn read_lock(p: manifest::Project&, g: Graph&) {
    let path = str(p.root, "/Honk.lock"); if !file_exists(path) { return; }
    let input = platform::load(path); var doc = toml::Document { .. }; let error = toml::parse_into(input, doc);
    platform::require(error.len == 0, str("invalid lockfile: ", error));
    manifest::keys(doc, 0, ["version", "compiler", "dependency"]);
    let v = toml::find(doc, 0, "version");
    platform::require(v >= 0 && doc.nodes[v].kind == toml::Kind.Integer && doc.nodes[v].integer == 1, "unsupported lockfile version");
    let array = toml::find(doc, 0, "dependency"); if array < 0 { return; }
    platform::require(doc.nodes[array].kind == toml::Kind.Array, "invalid lock dependency array");
    var id = doc.nodes[array].first;
    while id >= 0 {
        manifest::keys(doc, id, ["name", "path", "git", "rev", "commit"]);
        let name = manifest::string(doc, id, "name"); let path = manifest::string(doc, id, "path");
        let git = manifest::string(doc, id, "git"); let rev = manifest::string(doc, id, "rev"); let commit = manifest::string(doc, id, "commit");
        platform::require(manifest::identifier(name), "invalid name in lockfile");
        for old in g.old { platform::require(old.name != name, "duplicate name in lockfile"); }
        if git.len > 0 { platform::require(manifest::commit(commit), "invalid Git commit in lockfile"); }
        platform::require(g.old.len < 256, "lock dependency limit is 256");
        g.old.push(Node { name: str(name), path: str(path), git: str(git), rev: str(rev), commit: str(commit), directory: [], entry: [], visiting: false });
        id = doc.nodes[id].next;
    }
}
fn lock_text(g: Graph&) -> u8[>..] {
    var out = str("# Generated by Honk. Commit this file.\nversion = 1\ncompiler = "); manifest::quoted(out, g.revision); out.push('\n');
    for n in g.nodes {
        out.append("\n[[dependency]]\nname = "); manifest::quoted(out, n.name);
        out.append("\npath = "); manifest::quoted(out, n.path);
        out.append("\ngit = "); manifest::quoted(out, n.git);
        out.append("\nrev = "); manifest::quoted(out, n.rev);
        out.append("\ncommit = "); manifest::quoted(out, n.commit); out.push('\n');
    }
    return out;
}
fn index(g: Graph&, name: u8[:]) -> i64 { for n, i in g.nodes { if n.name == name { return i; } } return -1; }
fn node(g: Graph&, index: i64) -> Node& {
    for n, i in g.nodes { if i == index { return n; } }
    abort("invalid internal dependency index");
}
fn add(g: Graph&, dep: manifest::Dependency&, base: u8[:], depth: i64) {
    manifest::validate_dependency(dep);
    platform::require(depth <= 64 && g.nodes.len < 256, "dependency graph limit exceeded (256 packages / depth 64)");
    let candidate = if dep.path.len > 0 && dep.path[0] == '/' { str(dep.path) } else { str(base, "/", dep.path) };
    let local = if dep.path.len > 0 { platform::absolute(candidate) } else { str("") };
    let existing = index(g, dep.name);
    if existing >= 0 {
        let n .= node(g, existing);
        platform::require(n.directory == local || (n.git.len > 0 && n.git == dep.git && n.rev == dep.rev), str("conflicting dependency: ", dep.name));
        if g.current >= 0 { g.edges.push(Edge { g.current, existing }); } else if !dep.dev { n.production = true; } return;
    }
    var commit: u8[>..] = []; var directory = str(local);
    if dep.git.len > 0 {
        var old = -1;
        for n, i in g.old { if n.name == dep.name && n.git == dep.git && n.rev == dep.rev { old = i; } }
        if old >= 0 && !g.update { for n, i in g.old { if i == old { commit = str(n.commit); } } }
        else { platform::require(!g.locked, str("lockfile must change for ", dep.name)); }
        // The cache key is a deterministic encoding of source bytes, not a security hash.
        // Exact source identity and commit are checked independently before use.
        let repo = str(g.cache, "/git/", hash(dep.git));
        platform::require(platform::mkdir(str(g.cache, "/git")), "cannot create Git cache");
        if !is_dir(repo) {
            platform::require(!g.offline, str("dependency not cached: ", dep.name));
            platform::git(["init", "--bare", repo], base);
            platform::save(str(repo, "/honk-source"), dep.git);
        }
        let identity = platform::load(str(repo, "/honk-source")); platform::require(identity == dep.git, "Git cache identity mismatch");
        if commit.len == 0 {
            platform::require(!g.offline, "cannot resolve an unlocked Git ref offline");
            platform::git(["--git-dir", repo, "fetch", "--no-tags", "--depth=1", "--", dep.git, dep.rev], base);
            commit = platform::git(["--git-dir", repo, "rev-parse", "--verify", "FETCH_HEAD^{commit}"], base);
        }
        platform::require(manifest::commit(commit), "Git did not resolve a full commit");
        directory = str(g.cache, "/sources/", hash(dep.git), "-", commit);
        let ready = str(directory, ".ready");
        if !is_dir(directory) || !file_exists(ready) {
            platform::require(!g.offline, str("locked dependency source missing from cache: ", dep.name));
            platform::git(["--git-dir", repo, "fetch", "--no-tags", "--depth=1", "--", dep.git, commit], base);
            platform::require(platform::remove_tree(directory), "cannot clear incomplete source cache");
            platform::git(["--git-dir", repo, "worktree", "prune", "--expire", "now"], base);
            platform::require(platform::mkdir(directory), "cannot create source cache");
            // Detached worktree requires no hooks, filters, submodules, or build scripts.
            platform::git(["--git-dir", repo, "worktree", "add", "--detach", directory, commit], base);
            platform::save(ready, commit);
        }
        platform::require(platform::load(ready) == commit, "cached source completion marker has the wrong commit");
        let actual = platform::git(["-C", directory, "rev-parse", "HEAD"], base);
        platform::require(actual == commit, "cached Git checkout does not match lockfile");
        let dirty = platform::git(["-C", directory, "status", "--porcelain", "--untracked-files=all", "--ignored=matching"], base);
        platform::require(dirty.len == 0, "cached Git checkout has local changes; remove its cache directory and fetch again");
    }
    var entry = str(dep.name, ".goose");
    if file_exists(str(directory, "/Honk.toml")) {
        var child = manifest::Project { .. }; manifest::load(directory, child);
        platform::require(child.kind == "lib", "dependency Honk.toml must describe a library"); entry = str(child.entry);
    }
    platform::require(file_exists(str(directory, "/", entry)), str("missing dependency entry: ", dep.name, " (", entry, ")"));
    let id = g.nodes.len;
    // Keep path spellings in the lockfile portable for direct local dependencies.
    g.nodes.push(Node { name: str(dep.name), path: str(dep.path), git: str(dep.git), rev: str(dep.rev), commit: copy(commit), directory: copy(directory), entry: copy(entry), visiting: true });
    if g.current >= 0 { g.edges.push(Edge { g.current, id }); } else if !dep.dev { node(g, id).production = true; }
}
fn expand(g: Graph&, id: i64) {
    let n .= node(g, id); let directory = str(n.directory); let entry = str(n.entry);
    g.current = id;
    if file_exists(str(directory, "/Honk.toml")) {
        var child = manifest::Project { .. }; manifest::load(directory, child);
        for d in child.dependencies { if !d.dev { add(g, d, directory, 0); } }
    }
    let text = platform::load(str(directory, "/", entry)); let reqs = source::requirements(text);
    for req in reqs {
        var path: u8[>..] = []; var git: u8[>..] = []; var rev: u8[>..] = [];
        if req.source.len > 0 && (req.source[0] == '.' || req.source[0] == '/') { path = str(req.source); }
        else {
            var at = req.source.len; while at > 0 && req.source[at - 1] != '@' { at--; }
            platform::require(at > 0 && at < req.source.len, "source import needs a Git ref");
            let url = req.source[..at - 1]; rev = str(req.source[at..]);
            var slashes = 0; for c in url { if c == '/' { slashes++; } }
            git = if url.len > 8 && url[..8] == "https://" { str(url) } else if slashes == 1 { str("https://github.com/", url) } else { str("https://", url) };
        }
        var d = manifest::Dependency { name: str(req.name), path: copy(path), git: copy(git), rev: copy(rev), .. };
        platform::require(manifest::identifier(d.name), "invalid sourced dependency name");
        add(g, d, project::parent(str(directory, "/", entry)), 0);
    }
    n.visiting = false;
}
fn acyclic(g: Graph&) {
    var degrees: i64[256] = [0; 256]; var done: bool[256] = [false; 256];
    for edge in g.edges { degrees[edge.child]++; }
    var count = 0;
    for round in g.nodes.len {
        var found = -1;
        for i in g.nodes.len { if !done[i] && degrees[i] == 0 { found = i; break; } }
        if found < 0 { break; }
        done[found] = true; count++;
        for edge in g.edges { if edge.parent == found { degrees[edge.child]--; } }
    }
    platform::require(count == g.nodes.len, "dependency cycle detected");
}

fn resolve(p: manifest::Project&, g: Graph&) {
    g.revision = str(if p.revision.len > 0 { p.revision[..] } else { toolchain::REVISION });
    read_lock(p, g);
    for dep in p.dependencies { add(g, dep, p.root, 0); }
    var cursor = 0; while cursor < g.nodes.len { expand(g, cursor); cursor++; } acyclic(g);
    let text = lock_text(g); let file = str(p.root, "/Honk.lock");
    if file_exists(file) { let old = platform::load(file); if old == text { return; } }
    platform::require(!g.locked, "Honk.lock is missing or out of date; run honk fetch"); platform::save(file, text);
}

fn activate(g: Graph&, include_dev: bool) {
    for round in g.nodes.len {
        for edge in g.edges { if node(g, edge.parent).production { node(g, edge.child).production = true; } }
    }
    for node in g.nodes { node.enabled = include_dev || node.production; }
}
