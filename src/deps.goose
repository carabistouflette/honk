namespace deps;
import std;
import os;
import toml;
import semver;
import task;
import .version_policy;
import .tag_select;
import .tag_catalog;
import .manifest;
import .platform;
import .source;
import .project;
import .toolchain;
struct Node { name: u8[], path: u8[], git: u8[], rev: u8[], commit: u8[], directory: u8[], entry: u8[], production: bool = false, enabled: bool = true, visiting: bool = true, requirement: u8[] = [] }
struct Edge { parent: i64, child: i64 }
root struct Graph { edges: Edge[>..], current: i64 = -1, nodes: Node[>..], old: Node[>..], cache: u8[>..], revision: u8[>..], locked: bool = false, offline: bool = false, update: bool = false }
fn locked_version(reference: const u8[:], requirement: const u8[:]) -> bool {
    if !manifest::version_requirement(requirement) || !tag_catalog::reference(reference) { return false; }
    if tag_select::spelling(reference).len > 64 { return false; }
    let requested, request_error = semver::parse_requirement(requirement);
    let version, version_error = version_policy::parse_tag(reference);
    return request_error.kind == semver::ErrorKind.None && version_error.kind == semver::ErrorKind.None && semver::matches(requested, version);
}
fn read_lock(p: manifest::Project&, g: Graph&) {
    let path = str(p.root, "/Honk.lock"); if !file_exists(path) { return; }
    let input = platform::load(path); var doc = toml::Document { .. }; let error = toml::parse_into(input, doc);
    platform::require(error.len == 0, str("invalid lockfile: ", error));
    manifest::keys(doc, 0, ["version", "compiler", "dependency"]);
    let v = toml::find(doc, 0, "version");
    platform::require(v >= 0 && doc.nodes[v].kind == toml::Kind.Integer && doc.nodes[v].integer == 1, "unsupported lockfile version");
    let array = toml::find(doc, 0, "dependency"); if array < 0 { return; }
    platform::require(doc.nodes[array].kind == toml::Kind.Array, "invalid lock dependency array");
    var id = doc.nodes[array].first;
    while id >= 0 {
        manifest::keys(doc, id, ["name", "path", "git", "rev", "commit", "requirement"]);
        let name = manifest::string(doc, id, "name"); let path = manifest::string(doc, id, "path");
        let git = manifest::string(doc, id, "git"); let rev = manifest::string(doc, id, "rev"); let commit = manifest::string(doc, id, "commit");
        let requirement = manifest::string(doc, id, "requirement");
        if toml::find(doc, id, "requirement") >= 0 {
            platform::require(git.len > 0 && path.len == 0 && locked_version(rev, requirement), "invalid version requirement/tag identity in lockfile");
        }
        platform::require(manifest::identifier(name), "invalid name in lockfile");
        for old in g.old { platform::require(old.name != name, "duplicate name in lockfile"); }
        if git.len > 0 { platform::require(manifest::commit(commit), "invalid Git commit in lockfile"); }
        platform::require(g.old.len < 256, "lock dependency limit is 256");
        g.old.push(Node { name: str(name), path: str(path), git: str(git), rev: str(rev), commit: str(commit), directory: [], entry: [], visiting: false, requirement: str(requirement) });
        id = doc.nodes[id].next;
    }
}
fn lock_text(g: Graph&) -> u8[>..] {
    var out = str("# Generated by Honk. Commit this file.\nversion = 1\ncompiler = "); manifest::quoted(out, g.revision); out.push('\n');
    for n in g.nodes {
        out.append("\n[[dependency]]\nname = "); manifest::quoted(out, n.name);
        out.append("\npath = "); manifest::quoted(out, n.path);
        out.append("\ngit = "); manifest::quoted(out, n.git);
        out.append("\nrev = "); manifest::quoted(out, n.rev);
        if n.requirement.len > 0 { out.append("\nrequirement = "); manifest::quoted(out, n.requirement); }
        out.append("\ncommit = "); manifest::quoted(out, n.commit); out.push('\n');
    }
    return out;
}
fn index(g: Graph&, name: u8[:]) -> i64 { for n, i in g.nodes { if n.name == name { return i; } } return -1; }
fn node(g: Graph&, index: i64) -> Node& {
    for n, i in g.nodes { if i == index { return n; } }
    abort("invalid internal dependency index");
}
fn add(g: Graph&, dep: manifest::Dependency&, base: u8[:]) {
    manifest::validate_dependency(dep);
    let candidate = if dep.path.len > 0 && dep.path[0] == '/' { str(dep.path) } else { str(base, "/", dep.path) };
    let local = if dep.path.len > 0 { platform::absolute(candidate) } else { str("") };
    let existing = index(g, dep.name);
    if existing >= 0 {
        let n .= node(g, existing);
        platform::require(n.directory == local || (n.git.len > 0 && n.git == dep.git && n.requirement == dep.requirement && (dep.requirement.len > 0 || n.rev == dep.rev)), str("conflicting dependency: ", dep.name));
        if g.current >= 0 { g.edges.push(Edge { g.current, existing }); } else if !dep.dev { n.production = true; } return;
    }
    platform::require(g.nodes.len < 256, "dependency graph limit exceeded (256 packages)");
    var commit: u8[>..] = []; var directory = str(local); var selected_ref = str(dep.rev);
    if dep.git.len > 0 {
        var old = -1;
        for n, i in g.old { if n.name == dep.name && n.git == dep.git && n.requirement == dep.requirement && (dep.requirement.len > 0 || n.rev == dep.rev) { old = i; } }
        if old >= 0 && !g.update { for n, i in g.old { if i == old { commit = str(n.commit); selected_ref = str(n.rev); } } }
        else { platform::require(!g.locked, str("lockfile must change for ", dep.name)); }
        // The cache key is a deterministic encoding of source bytes, not a security hash.
        // Exact source identity and commit are checked independently before use.
        let repo = str(g.cache, "/git/", hash(dep.git));
        platform::require(platform::mkdir(str(g.cache, "/git")), "cannot create Git cache");
        let identity_file = str(repo, "/honk-source");
        platform::require(platform::kind(repo) == 0 || platform::kind(repo) == 2, "Git cache must be a directory without symlinks");
        if platform::kind(repo) == 2 && platform::kind(identity_file) == 0 {
            platform::require(!g.offline, "incomplete Git cache cannot be repaired offline");
            platform::require(platform::kind(str(repo, "/worktrees")) == 0, "Git cache identity missing; remove corrupted cache before fetching");
            platform::require(platform::remove_tree(repo), "cannot clear incomplete Git cache");
        }
        if platform::kind(repo) == 0 {
            platform::require(!g.offline, str("dependency not cached: ", dep.name));
            let temporary = str(repo, ".initializing");
            platform::require(platform::remove_tree(temporary), "cannot clear temporary Git initialization");
            platform::git(["init", "--bare", temporary], base);
            platform::save(str(temporary, "/honk-source"), dep.git);
            platform::require(rename_file(temporary, repo), "cannot publish initialized Git cache");
        }
        let identity = platform::load(str(repo, "/honk-source")); platform::require(identity == dep.git, "Git cache identity mismatch");
        if commit.len == 0 {
            platform::require(!g.offline, "cannot resolve an unlocked Git ref offline");
            if dep.requirement.len > 0 {
                let advertised = platform::git(["ls-remote", "--tags", "--sort=refname", "--", dep.git], base, 60000, false);
                let selected, selection_error = tag_catalog::select(dep.requirement, advertised);
                platform::require(selection_error != tag_select::Error.NoMatch, "no Git tag satisfies version requirement");
                platform::require(selection_error != tag_select::Error.Ambiguous, "ambiguous highest Git version (alias/build tie)");
                platform::require(selection_error == tag_select::Error.None, "invalid or oversized Git tag catalog");
                selected_ref = str(selected.reference);
                platform::git(["--git-dir", repo, "fetch", "--no-tags", "--depth=1", "--", dep.git, selected_ref], base);
                commit = platform::git(["--git-dir", repo, "rev-parse", "--verify", "FETCH_HEAD^{commit}"], base);
                platform::require(commit == selected.commit, "Git tag selected commit moved or did not peel to the advertised commit");
            } else {
                platform::git(["--git-dir", repo, "fetch", "--no-tags", "--depth=1", "--", dep.git, dep.rev], base);
                commit = platform::git(["--git-dir", repo, "rev-parse", "--verify", "FETCH_HEAD^{commit}"], base);
            }
        }
        platform::require(manifest::commit(commit), "Git did not resolve a full commit");
        directory = str(g.cache, "/sources/", hash(dep.git), "-", commit);
        let ready = str(directory, ".ready");
        if platform::kind(directory) != 2 || !file_exists(ready) {
            platform::require(!g.offline, str("locked dependency source missing from cache: ", dep.name));
            if platform::kind(ready) != 0 { platform::require(platform::unlink_regular(ready), "cannot invalidate source completion marker"); }
            platform::git(["--git-dir", repo, "fetch", "--no-tags", "--depth=1", "--", dep.git, commit], base);
            platform::require(platform::remove_tree(directory), "cannot clear incomplete source cache");
            platform::git(["--git-dir", repo, "worktree", "prune", "--expire", "now"], base);
            platform::require(platform::mkdir(directory), "cannot create source cache");
            // Detached worktree requires no hooks, filters, submodules, or build scripts.
            platform::git(["--git-dir", repo, "worktree", "add", "--detach", directory, commit], base);
            platform::save(ready, commit);
        }
        platform::require(platform::load(ready) == commit, "cached source completion marker has the wrong commit");
        let actual = platform::git(["-C", directory, "rev-parse", "HEAD"], base);
        platform::require(actual == commit, "cached Git checkout does not match lockfile");
        let dirty = platform::git(["-C", directory, "status", "--porcelain", "--untracked-files=all", "--ignored=matching"], base);
        platform::require(dirty.len == 0, "cached Git checkout has local changes; remove its cache directory and fetch again");
    }
    var entry = str(dep.name, ".goose");
    if file_exists(str(directory, "/Honk.toml")) {
        var child = manifest::Project { .. }; manifest::load(directory, child);
        platform::require(child.kind == "lib", "dependency Honk.toml must describe a library"); entry = str(child.entry);
        if dep.requirement.len > 0 {
            let selected_version, selected_error = version_policy::parse_tag(selected_ref);
            let declared_version, declared_error = semver::parse(child.version);
            platform::require(selected_error.kind == semver::ErrorKind.None && declared_error.kind == semver::ErrorKind.None && semver::compare(selected_version, declared_version) == 0, "package version does not match selected Git tag");
        }
    } else { platform::require(dep.requirement.len == 0, "version-selected Git dependency needs a Honk library manifest"); }
    var parents = entry.len; while parents > 0 && entry[parents - 1] != '/' { parents--; }
    if parents > 0 { platform::require(platform::directory(directory, entry[..parents - 1]), "dependency entry parent must be a directory without symlink components"); }
    platform::require(file_exists(str(directory, "/", entry)), str("missing dependency entry: ", dep.name, " (", entry, ")"));
    let id = g.nodes.len;
    // Keep path spellings in the lockfile portable for direct local dependencies.
    g.nodes.push(Node { name: str(dep.name), path: str(dep.path), git: str(dep.git), rev: str(selected_ref), commit: copy(commit), directory: copy(directory), entry: copy(entry), visiting: true, requirement: str(dep.requirement) });
    if g.current >= 0 { g.edges.push(Edge { g.current, id }); } else if !dep.dev { node(g, id).production = true; }
}
fn expand(g: Graph&, id: i64) {
    let n .= node(g, id); let directory = str(n.directory); let entry = str(n.entry);
    g.current = id;
    if file_exists(str(directory, "/Honk.toml")) {
        var child = manifest::Project { .. }; manifest::load(directory, child);
        for d in child.dependencies { if !d.dev { add(g, d, directory); } }
    }
    let text = platform::load(str(directory, "/", entry)); let reqs = source::requirements(text);
    for req in reqs {
        var path: u8[>..] = []; var git: u8[>..] = []; var rev: u8[>..] = [];
        if req.source.len > 0 && (req.source[0] == '.' || req.source[0] == '/') { path = str(req.source); }
        else {
            var at = req.source.len; while at > 0 && req.source[at - 1] != '@' { at--; }
            platform::require(at > 0 && at < req.source.len, "source import needs a Git ref");
            let url = req.source[..at - 1]; rev = str(req.source[at..]);
            var slashes = 0; for c in url { if c == '/' { slashes++; } }
            git = if url.len > 8 && url[..8] == "https://" { str(url) } else if slashes == 1 { str("https://github.com/", url) } else { str("https://", url) };
        }
        var d = manifest::Dependency { name: str(req.name), path: copy(path), git: copy(git), rev: copy(rev), .. };
        platform::require(manifest::identifier(d.name), "invalid sourced dependency name");
        add(g, d, project::parent(str(directory, "/", entry)));
    }
    n.visiting = false;
}
// Each expanded node can add 256 manifest edges plus 256 source-import
// edges, including duplicates. Root declarations do not add edges.
const MAX_GRAPH_EDGES = 256 * (256 + 256);
fn graph_error(g: Graph&) -> task::Error {
    var limits = task::Limits { tasks: 256, edges: MAX_GRAPH_EDGES };
    if g.nodes.len > limits.tasks { return task::Error { kind: task::ErrorKind.TaskLimit, .. }; }
    if g.edges.len > limits.edges { return task::Error { kind: task::ErrorKind.EdgeLimit, .. }; }
    var edges: task::Edge[>..] = [];
    // This is cycle validation only. Honk's parent is the dependent package;
    // reversing all edges would preserve cycles, but no task execution order
    // should be inferred from this adapter's parent -> child convention.
    for edge in g.edges { edges.push(task::Edge { before: edge.parent, after: edge.child }); }
    let order, error = task::plan(g.nodes.len, edges, limits);
    // Keep g.nodes and its discovery/lockfile order unchanged.
    return error;
}
fn acyclic(g: Graph&) {
    let error = graph_error(g);
    platform::require(error.kind != task::ErrorKind.Cycle, "dependency cycle detected");
    platform::require(error.kind == task::ErrorKind.None, "invalid dependency graph");
}

fn resolve(p: manifest::Project&, g: Graph&) {
    g.revision = str(if p.revision.len > 0 { p.revision[..] } else { toolchain::REVISION });
    read_lock(p, g);
    for dep in p.dependencies { add(g, dep, p.root); }
    var cursor = 0; while cursor < g.nodes.len { expand(g, cursor); cursor++; } acyclic(g);
    let text = lock_text(g);
    platform::require(text.len <= manifest::MAX_INPUT_BYTES, "resolved lockfile exceeds 1 MiB; original is unchanged");
    let file = str(p.root, "/Honk.lock");
    if file_exists(file) { let old = platform::load(file); if old == text { return; } }
    platform::require(!g.locked, "Honk.lock is missing or out of date; run honk fetch"); platform::save(file, text);
}

fn activate(g: Graph&, include_dev: bool) {
    // Fixed-size node IDs permit constant-time propagation without rescanning variable-size owners.
    var active: bool[256] = [false; 256];
    for node, i in g.nodes { active[i] = include_dev || node.production; }
    if !include_dev {
        for round in g.nodes.len {
            var changed = false;
            for edge in g.edges {
                if active[edge.parent] && !active[edge.child] { active[edge.child] = true; changed = true; }
            }
            if !changed { break; }
        }
    }
    for node, i in g.nodes { node.enabled = active[i]; }
}
