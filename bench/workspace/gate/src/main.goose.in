import version_rules;
import std;
import os;
fn main() {
    let argv = args();
    if argv.len != 3 { print("usage: version_gate REQUIREMENT VERSION"); exit(2); }
    let decision = version_rules::decide(argv[1], argv[2]);
    if decision == version_rules::Decision.Match { print("match"); return; }
    if decision == version_rules::Decision.NoMatch { print("no match"); exit(1); }
    print(if decision == version_rules::Decision.InvalidRequirement { "invalid requirement" } else { "invalid version" });
    exit(2);
}
